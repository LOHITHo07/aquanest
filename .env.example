# ============================================================
# AQUANEST SYSTEM ENVIRONMENT VARIABLES CONFIGURATION
# ============================================================

# System Execution Mode: 'SIMULATION' or 'LIVE'
DATA_MODE=SIMULATION

# Java Spring Boot Server Port
PORT=8080

# Backend Base API URL (for Python Streamlit and scripts)
BACKEND_URL=http://localhost:8080/api

# MQTT Broker Configuration (HiveMQ / Mosquitto)
MQTT_BROKER=tcp://broker.hivemq.com:1883
MQTT_PORT=1883
MQTT_CLIENT_ID=aquanest-backend-server
MQTT_USERNAME=
MQTT_PASSWORD=

# Firebase Cloud Firestore & Authentication
FIREBASE_PROJECT_ID=aquanest-iot-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@aquanest-iot-firebase.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"
FIREBASE_CREDENTIALS_PATH=

# Water Management System Thresholds
AQUANEST_TANK_CAPACITY=4000.0
AQUANEST_LOW_THRESHOLD_PCT=20.0
AQUANEST_FULL_THRESHOLD_PCT=90.0
AQUANEST_WATER_TARIFF=0.10
AQUANEST_FIXED_CHARGE=200.0
AQUANEST_FLOW_CALIBRATION=450.0
